# Variables d'environnement — a copier en .env et a remplir
# Ne jamais commiter le fichier .env

# Base de donnees
DATABASE_URL=postgresql+psycopg://caneco_user:caneco_pass@localhost:5432/caneco_db

# Authentification JWT
JWT_SECRET_KEY=changeme_remplacer_par_une_chaine_aleatoire_de_64_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API LLM (optionnelle — l'outil fonctionne sans cette cle)
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Environnement
ENV=development
